# Server only. Do not copy into the iPhone app or commit your real .env.
BACKBOARD_API_KEY=
# A DIFFERENT random token for your iPhone to access the local backend.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SIGNLOOP_BACKEND_TOKEN=
# The catalog's Llama 3.1 8B entry may be unavailable. Probe before changing.
CEREBRAS_MODEL=openai/gpt-oss-120b
# Optional server-side speech proxy. Never put either value in the iPhone app.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
