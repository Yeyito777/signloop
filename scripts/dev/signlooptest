#!/usr/bin/env bash
# signlooptest [name|path|.] [core|backend|native|build|open]
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$SCRIPT_DIR/worktree-common.sh"
[[ $# -le 2 ]] || worktree_die "Usage: signlooptest [name|path|.] [core|backend|native|build|open]"
INPUT="${1:-.}"
case "$INPUT" in
  .) TARGET="$SIGNLOOP_CHECKOUT" ;;
  "$SIGNLOOP_ROOT") TARGET="$SIGNLOOP_ROOT" ;;
  *) TARGET="$(resolve_worktree_dir "$INPUT")" ;;
esac
require_registered_worktree "$TARGET"
case "${2:-core}" in
  core)
    # No camera, provisioning, network, or API credentials needed.
    (cd "$TARGET" && bash ios/scripts/test-core.sh)
    ;;
  backend)
    (cd "$TARGET" && python3 -m unittest backend.test_service backend.test_matcher backend.test_hand_tracking backend.test_static backend.test_stream_replay backend.test_stream_calibrate backend.test_pretrained backend.test_motion backend.test_holdout -v)
    ;;
  native)
    # Actual Swift HTTP adapter + local temporal engine; synthetic data only.
    (cd "$TARGET" && python3 -m backend.test_native && python3 -m backend.test_temporal_native &&
      python3 -m backend.test_pretrained_native && python3 -m backend.test_motion_native)
    ;;
  build)
    bootstrap_worktree "$TARGET"
    (cd "$TARGET/ios" && xcodebuild -project Signloop.xcodeproj -scheme Signloop \
      -configuration Debug -destination 'generic/platform=iOS' \
      -derivedDataPath "$TARGET/ios/build" CODE_SIGNING_ALLOWED=NO build)
    ;;
  open)
    bootstrap_worktree "$TARGET"
    open "$TARGET/ios/Signloop.xcodeproj"
    ;;
  *) worktree_die "Mode must be core, backend, native, build, or open." ;;
esac
