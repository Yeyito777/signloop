#!/usr/bin/env bash
# Best-effort, offline-only regeneration after branch checkout.
# Explicit create-worktree does its full bootstrap once, after seeding artifacts.
[[ "${SIGNLOOP_SKIP_POST_CHECKOUT:-}" == 1 || "${3:-}" != 1 ]] && exit 0
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[[ -f "$ROOT/ios/project.yml" ]] || exit 0
# Do not surprise a plain git checkout with downloads, signing or app launches.
if command -v xcodegen >/dev/null &&
  [[ -d "$ROOT/ios/Vendor/MediaPipeTasksVision/frameworks" &&
     -d "$ROOT/ios/Vendor/MediaPipeTasksCommon/frameworks" &&
     -f "$ROOT/ios/Vendor/TensorFlowLiteSwift/Interpreter.swift" &&
     -f "$ROOT/ios/Vendor/TensorFlowLiteHeaders/TensorFlowLiteC/c_api.h" &&
     -f "$ROOT/ios/Signloop/Resources/gesture_recognizer.task" &&
     -f "$ROOT/ios/Signloop/Resources/hand_landmarker.task" ]]; then
  (cd "$ROOT/ios" && xcodegen generate) ||
    printf 'Signloop: regenerate manually with bash ios/scripts/bootstrap.sh\n' >&2
fi
exit 0
