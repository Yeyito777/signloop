# Preferred: talk to the local backend. The ElevenLabs key stays in the repo-root .env.
EXPO_PUBLIC_VOICE_BACKEND_URL=http://127.0.0.1:8787
EXPO_PUBLIC_SIGNLOOP_BACKEND_TOKEN=

# Unsafe fallback: Expo embeds these in the client bundle. Do not use a live key here.
# EXPO_PUBLIC_ELEVENLABS_API_KEY=
# EXPO_PUBLIC_ELEVENLABS_VOICE_ID=
